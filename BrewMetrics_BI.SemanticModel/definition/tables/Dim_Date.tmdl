	partition Dim_Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(Fact_Sales[Date]),
				        MAX(Fact_Sales[Date])
				    ),
				    "Year", YEAR([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Month Number", MONTH([Date]),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Day", DAY([Date])
				)

	annotation PBI_Id = 4d55e99030b744b9813c7cf72083219a

